# 统一换行：仓库里一律存 LF，避免 Windows 上 CRLF/LF 反复产生整文件 diff
* text=auto eol=lf

# 明确按文本处理
*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.csv   text eol=lf
*.html  text eol=lf
*.cypher text eol=lf
*.gml   text eol=lf
*.txt   text eol=lf
*.cmd   text eol=crlf

# 二进制，禁止换行转换
*.png   binary
*.jpg   binary
*.zip   binary
*.docx  binary
*.sqlite binary

