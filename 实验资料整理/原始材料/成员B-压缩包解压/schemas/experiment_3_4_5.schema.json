{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/data-mining/experiments-3-5.schema.json",
  "title": "Experiments 3, 4, and 5 output bundle",
  "type": "object",
  "properties": {
    "route_records": {"type": "array", "items": {"$ref": "#/$defs/routeRecord"}},
    "route_steps": {"type": "array", "items": {"$ref": "#/$defs/routeStep"}},
    "route_hierarchy": {"type": "array", "items": {"$ref": "#/$defs/routeHierarchy"}},
    "route_comparisons": {"type": "array", "items": {"$ref": "#/$defs/routeComparison"}},
    "pronoun_mentions": {"type": "array", "items": {"$ref": "#/$defs/coreferenceMention"}},
    "condition_advice_mappings": {"type": "array", "items": {"$ref": "#/$defs/conditionAdviceMapping"}}
  },
  "$defs": {
    "offsetSpan": {
      "type": "object",
      "required": ["start", "end", "unit"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "unit": {"const": "unicode_codepoint"}
      },
      "additionalProperties": false
    },
    "evidenceSpan": {
      "type": "object",
      "required": ["start", "end", "unit", "text"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "unit": {"const": "unicode_codepoint"},
        "text": {"type": "string"}
      },
      "additionalProperties": false
    },
    "activity": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": {"enum": ["enter", "visit", "view", "walk", "transport", "eat", "rest", "photo", "exit"]},
        "text": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "routeStep": {
      "type": "object",
      "required": ["step_id", "route_id", "step_index", "time_block_index", "time_bucket", "poi_surface", "poi_canonical", "activity", "event_kind", "source_span", "evidence_span"],
      "properties": {
        "step_id": {"type": "string"},
        "route_id": {"type": "string"},
        "step_index": {"type": "integer", "minimum": 1},
        "time_block_index": {"type": "integer", "minimum": 1},
        "time_bucket": {"enum": ["上午", "中午", "下午", "晚上", "全天", "未标注时段"]},
        "time_evidence": {"type": ["string", "null"]},
        "poi_surface": {"type": "string"},
        "poi_canonical": {"type": "string"},
        "activity": {"type": "array", "items": {"$ref": "#/$defs/activity"}, "maxItems": 2},
        "event_kind": {"enum": ["visit", "return"]},
        "source_span": {"$ref": "#/$defs/offsetSpan"},
        "evidence_span": {"$ref": "#/$defs/evidenceSpan"}
      },
      "additionalProperties": false
    },
    "routeRecord": {
      "type": "object",
      "required": ["route_id", "attraction", "text_type", "title", "source", "source_url", "format_detected", "source_text", "step_count", "steps"],
      "properties": {
        "route_id": {"type": "string"},
        "attraction": {"type": "string"},
        "text_type": {"enum": ["official_route", "traveler_note"]},
        "title": {"type": "string"},
        "source": {"type": "string"},
        "source_url": {"type": "string"},
        "format_detected": {"type": "array", "items": {"enum": ["numbered", "arrow_chain", "time_segmented_prose", "prose"]}},
        "source_text": {"type": "string"},
        "step_count": {"type": "integer", "minimum": 0},
        "steps": {"type": "array", "description": "Ordered step_id references; full step objects reside in route_steps."}
      },
      "additionalProperties": false
    },
    "timeBlock": {
      "type": "object",
      "required": ["block_index", "time_bucket", "step_ids"],
      "properties": {
        "block_index": {"type": "integer", "minimum": 1},
        "time_bucket": {"enum": ["上午", "中午", "下午", "晚上", "全天", "未标注时段"]},
        "step_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      },
      "additionalProperties": false
    },
    "routeHierarchy": {
      "type": "object",
      "required": ["attraction", "route_id", "root", "time_blocks"],
      "properties": {
        "attraction": {"type": "string"},
        "route_id": {"type": "string"},
        "root": {"type": "string"},
        "time_blocks": {"type": "array", "items": {"$ref": "#/$defs/timeBlock"}}
      },
      "additionalProperties": false
    },
    "routeComparison": {
      "type": "object",
      "required": ["comparison_id", "attraction", "official_route_id", "traveler_route_id", "official_poi_sequence", "traveler_poi_sequence", "shared_pois", "official_coverage", "sequence_lcs_similarity", "order_consistency", "official_time_share", "traveler_time_share", "time_distribution_total_variation", "interpretation"],
      "properties": {
        "comparison_id": {"type": "string"},
        "attraction": {"type": "string"},
        "official_route_id": {"type": "string"},
        "traveler_route_id": {"type": "string"},
        "official_poi_sequence": {"type": "array", "items": {"type": "string"}},
        "traveler_poi_sequence": {"type": "array", "items": {"type": "string"}},
        "shared_pois": {"type": "array", "items": {"type": "string"}},
        "official_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "sequence_lcs_similarity": {"type": "number", "minimum": 0, "maximum": 1},
        "order_consistency": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "official_time_share": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
        "traveler_time_share": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
        "time_distribution_total_variation": {"type": "number", "minimum": 0, "maximum": 1},
        "interpretation": {"type": "string"}
      },
      "additionalProperties": false
    },
    "coreferenceMention": {
      "type": "object",
      "required": ["mention_id", "record_id", "attraction", "text_type", "pronoun", "occurrence", "pronoun_span", "sentence_span", "sentence", "candidate_antecedent", "predicted_antecedent", "predicted_antecedent_span", "gold_antecedent", "gold_antecedent_span", "annotation_status", "annotation_origin", "correct", "method"],
      "properties": {
        "mention_id": {"type": "string"},
        "record_id": {"type": "string"},
        "attraction": {"type": "string"},
        "text_type": {"enum": ["official_route", "traveler_note"]},
        "pronoun": {"type": "string"},
        "occurrence": {"type": "integer", "minimum": 1},
        "pronoun_span": {"$ref": "#/$defs/offsetSpan"},
        "sentence_span": {"$ref": "#/$defs/offsetSpan"},
        "sentence": {"type": "string"},
        "candidate_antecedent": {"type": ["object", "null"]},
        "predicted_antecedent": {"type": ["string", "null"]},
        "predicted_antecedent_span": {"type": ["object", "null"]},
        "gold_antecedent": {"type": ["string", "null"]},
        "gold_antecedent_span": {"type": ["object", "null"]},
        "annotation_status": {"enum": ["preannotated_pending_student_review", "unlabeled"]},
        "annotation_origin": {"type": ["string", "null"]},
        "annotation_note": {"type": ["string", "null"]},
        "correct": {"type": ["boolean", "null"]},
        "method": {"type": "string"}
      },
      "additionalProperties": false
    },
    "conditionEvidence": {
      "type": "object",
      "required": ["attraction", "record_id", "text_type", "sentence_index", "condition_type", "condition_text", "condition_span", "advice_text", "advice_span", "sentence_span", "evidence_sentence", "rule"],
      "properties": {
        "attraction": {"type": "string"},
        "record_id": {"type": "string"},
        "text_type": {"enum": ["official_route", "traveler_note"]},
        "sentence_index": {"type": "integer", "minimum": 1},
        "condition_type": {"enum": ["weather", "visitor_type", "time_constraint", "crowd_level", "preference", "other"]},
        "condition_text": {"type": "string"},
        "condition_span": {"$ref": "#/$defs/offsetSpan"},
        "advice_text": {"type": "string"},
        "advice_span": {"$ref": "#/$defs/offsetSpan"},
        "sentence_span": {"$ref": "#/$defs/offsetSpan"},
        "evidence_sentence": {"type": "string"},
        "rule": {"type": "string"}
      },
      "additionalProperties": false
    },
    "conditionAdviceMapping": {
      "type": "object",
      "required": ["mapping_id", "attraction", "condition_type", "condition", "advice", "evidence_count", "source_record_ids", "evidence", "dedup_key", "student_review"],
      "properties": {
        "mapping_id": {"type": "string"},
        "attraction": {"type": "string"},
        "condition_type": {"enum": ["weather", "visitor_type", "time_constraint", "crowd_level", "preference", "other"]},
        "condition": {
          "type": "object",
          "required": ["text", "normalized"],
          "properties": {"text": {"type": "string"}, "normalized": {"type": "string"}},
          "additionalProperties": false
        },
        "advice": {
          "type": "object",
          "required": ["text", "normalized"],
          "properties": {"text": {"type": "string"}, "normalized": {"type": "string"}},
          "additionalProperties": false
        },
        "evidence_count": {"type": "integer", "minimum": 1},
        "source_record_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/conditionEvidence"}, "minItems": 1},
        "dedup_key": {"type": "string"},
        "student_review": {
          "type": "object",
          "required": ["status", "suggested_note", "review_scope"],
          "properties": {
            "status": {"const": "pending_student_confirmation"},
            "suggested_note": {"type": ["string", "null"]},
            "review_scope": {"enum": ["assistant_precheck_candidate", "not_in_precheck_sample"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
